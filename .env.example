# ═══════════════════════════════════════════════
# Libera - Neon PostgreSQL Configuration
# ═══════════════════════════════════════════════
#
# INSTRUCTIONS:
# 1. Create a Neon database at https://console.neon.tech
# 2. Go to your project → Connection Details
# 3. Copy the connection string
# 4. Paste it below (replace the placeholder)
#
# The connection string should look like:
# postgresql://neondb_owner:your_password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
#
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
